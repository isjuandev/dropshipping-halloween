# Destino público de pedidos (se ejecuta en el navegador).
PUBLIC_NEXOBITE_API_URL=https://api.nexobite.com/api/v1/public/dropshipping/viralyshop/leads

# Id numérico del producto en Dropi. Si se omite, NexoBite resuelve por nombre
# o por el único producto activo de la tienda.
PUBLIC_NEXOBITE_PRODUCT_ID=2272533

# Campaña de NexoBite a la que pertenece esta landing (slug visible en Ajustes > Campañas).
PUBLIC_NEXOBITE_CAMPAIGN_SLUG=viralyshop

# Cloudflare Turnstile (Opcional, antispam invisible)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analítica y Tracking (Opcionales)
PUBLIC_GTM_ID=
PUBLIC_PIXEL_ID=
