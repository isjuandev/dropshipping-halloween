# Modo de envío de pedidos: 'proxy' (recomendado) o 'directo'
PUBLIC_PEDIDO_MODO=proxy

# En modo directo: URL de producción del webhook de n8n expuesta al navegador
PUBLIC_PEDIDO_WEBHOOK_URL=https://n8n.tudominio.com/webhook/pedido-contraentrega

# En modo proxy (servidor Astro): URL privada del webhook y secreto compartido
N8N_WEBHOOK_URL=https://n8n.tudominio.com/webhook/pedido-contraentrega
N8N_WEBHOOK_SECRET=mi_super_secreto_webhook_12345

# Cloudflare Turnstile (Opcional, antispam invisible)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analítica y Tracking (Opcionales)
PUBLIC_GTM_ID=
PUBLIC_PIXEL_ID=
