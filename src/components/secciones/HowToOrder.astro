---
const steps = [
  {
    step: '01',
    icon: '📝',
    title: 'Llena tus Datos',
    desc: 'Elige tu pack y completa el formulario con tu ciudad y dirección de entrega en menos de 1 minuto.',
  },
  {
    step: '02',
    icon: '💬',
    title: 'Te Confirmamos el Pedido',
    desc: 'Validamos contigo los detalles y despachamos de inmediato con transportadoras certificadas en Colombia.',
  },
  {
    step: '03',
    icon: '📦',
    title: 'Pagas Cuando te Llegue',
    desc: 'El mensajero entrega el paquete sellado en la puerta de tu casa u oficina y pagas en efectivo o transferencia.',
  },
];
---

<section class="py-12 md:py-20 bg-sombra relative">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs uppercase tracking-widest text-calabaza font-bold px-3 py-1 rounded-full bg-calabaza/10 border border-calabaza/20 inline-block mb-3">
        Sin Fricción Ni Registro
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-hueso tracking-wide m-0">
        ¿CÓMO PEDIR EN 3 PASOS?
      </h2>
      <p class="text-ceniza text-sm sm:text-base mt-3 m-0">
        Sin tarjetas de crédito previas, sin trámites bancarios. Fácil, rápido y 100% seguro.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
      {steps.map((s, idx) => (
        <div class="bg-noche/80 border border-white/10 rounded-[14px] p-6 sm:p-7 relative flex flex-col justify-between shadow-xl">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-heading text-4xl text-calabaza/80 font-bold tabular-nums">
                {s.step}
              </span>
              <span class="text-3xl p-2 rounded-xl bg-sombra border border-white/10">
                {s.icon}
              </span>
            </div>

            <h3 class="font-heading text-2xl text-hueso tracking-wide mb-2 m-0">
              {s.title}
            </h3>

            <p class="text-ceniza text-sm leading-relaxed m-0">
              {s.desc}
            </p>
          </div>

          <div class="mt-6 pt-3 border-t border-white/5 text-[11px] font-semibold text-emerald-400">
            {idx === 0 && '⚡ Sin registros ni tarjetas'}
            {idx === 1 && '🤝 Confirmación ágil de despacho'}
            {idx === 2 && '🔒 Pago 100% contraentrega'}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
