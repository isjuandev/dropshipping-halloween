---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  rating: number;
  numResenas: number;
  testimonios: Array<{
    nombre: string;
    ciudad: string;
    foto?: ImageMetadata;
    texto: string;
    estrellas: number;
    packComprado: string;
    fecha: string;
  }>;
}

const { rating, numResenas, testimonios } = Astro.props;

// Distribución de estrellas (porcentajes sobre el total de reseñas)
const distribution = [
  { stars: 5, percent: 87 },
  { stars: 4, percent: 10 },
  { stars: 3, percent: 2 },
  { stars: 2, percent: 1 },
  { stars: 1, percent: 0 },
];

const totalResenas = numResenas.toLocaleString('es-CO');
---

<section class="py-14 md:py-24 bg-sombra border-y border-white/10 relative">
  <div class="max-w-6xl mx-auto px-4">

    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="badge-rgb text-xs uppercase tracking-widest text-hueso font-bold px-3 py-1 rounded-full inline-block mb-3">
        Clientes en Colombia
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-hueso tracking-wide m-0">
        ASÍ SE VEN LAS CASAS QUE YA LA TIENEN
      </h2>
      <p class="text-ceniza text-sm sm:text-base mt-3 m-0">
        Más de {totalResenas} hogares en Colombia ya decoraron con su malla LED RGB.
      </p>
    </div>

    {/* Resumen de calificación con desglose de barras */}
    <div class="borde-rgb rounded-2xl p-6 sm:p-8 max-w-3xl mx-auto mb-12 shadow-xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <div class="text-center md:border-r border-white/10 md:pr-6">
          <div class="font-heading text-6xl sm:text-7xl text-hueso font-bold leading-none tabular-nums">
            {rating}
          </div>
          <div class="flex justify-center text-calabaza text-lg my-1.5" aria-hidden="true">★★★★★</div>
          <span class="text-xs text-ceniza block">
            Basado en {totalResenas} calificaciones verificadas
          </span>
          <span class="inline-block mt-2 text-[11px] font-bold text-emerald-400 bg-emerald-950/60 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
            ✓ 97% la recomienda
          </span>
        </div>

        <div class="md:col-span-2 space-y-1.5">
          {distribution.map((d) => (
            <div class="flex items-center gap-3 text-xs">
              <span class="w-12 text-ceniza font-medium flex items-center gap-1 flex-shrink-0">
                <span>{d.stars}</span>
                <span class="text-calabaza">★</span>
              </span>
              <div class="flex-1 h-2.5 bg-white/10 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-neon-morado to-neon-cian rounded-full" style={`width: ${d.percent}%`}></div>
              </div>
              <span class="w-10 text-right text-ceniza tabular-nums font-semibold flex-shrink-0">
                {d.percent}%
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* 6 tarjetas UGC en mampostería (las fotos son opcionales) */}
    <div class="columns-1 md:columns-2 lg:columns-3 gap-5 [&>*]:mb-5">
      {testimonios.map((t) => (
        <article class="break-inside-avoid bg-noche/70 border border-white/10 rounded-2xl overflow-hidden hover:border-neon-morado/40 transition-colors shadow-lg">
          {t.foto && (
            <div class="aspect-[4/5] overflow-hidden">
              <Picture
                pictureAttributes={{ class: 'block w-full h-full' }}
                src={t.foto}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[400, 640, 800]}
                sizes="(min-width: 1024px) 360px, (min-width: 768px) 45vw, 92vw"
                alt={`Malla LED instalada por ${t.nombre} en ${t.ciudad}`}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover rounded-2xl"
              />
            </div>
          )}

          <div class="p-5">
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-2.5">
                <span class="w-10 h-10 rounded-full bg-gradient-to-br from-neon-morado to-neon-cian flex items-center justify-center font-heading text-xl text-white flex-shrink-0" aria-hidden="true">
                  {t.nombre.charAt(0)}
                </span>
                <div>
                  <h3 class="text-sm font-bold text-hueso leading-tight m-0">{t.nombre}</h3>
                  <span class="text-xs text-ceniza flex items-center gap-1">
                    <span aria-hidden="true">📍</span> {t.ciudad}
                  </span>
                </div>
              </div>
              <span class="text-[11px] text-ceniza">{t.fecha}</span>
            </div>

            <div class="flex items-center gap-1.5 text-calabaza text-sm mb-2">
              <span aria-label={`${t.estrellas} de 5 estrellas`}>{'★'.repeat(t.estrellas)}</span>
              <span class="text-[11px] text-emerald-400 font-semibold ml-1">✓ Compra verificada</span>
            </div>

            <p class="text-sm text-hueso/90 leading-relaxed italic m-0">"{t.texto}"</p>

            <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-xs text-ceniza">
              <span>Compró:</span>
              <span class="font-semibold text-neon-cian bg-neon-cian/10 px-2 py-0.5 rounded border border-neon-cian/25">
                {t.packComprado}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
