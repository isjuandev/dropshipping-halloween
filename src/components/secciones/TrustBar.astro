---
const items = [
  {
    icon: 'shield-check',
    title: 'Pago Contra Entrega',
    desc: 'Pagas en efectivo al recibir en tus manos',
  },
  {
    icon: 'truck',
    title: 'Envío 1 a 4 Días',
    desc: 'Despacho rápido a cualquier ciudad del país',
  },
  {
    icon: 'refresh-cw',
    title: 'Cambio si Llega Dañada',
    desc: 'Garantía inmediata sin complicaciones',
  },
  {
    icon: 'flame',
    title: '+3.000 Vendidas',
    desc: 'La máscara más pedida de esta temporada',
  },
];
---

<section class="w-full bg-sombra border-y border-white/10 py-6 sm:py-8" aria-label="Beneficios y confianza">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {items.map((item) => (
        <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-3 p-3 rounded-xl bg-noche/40 border border-white/5">
          <div class="w-10 h-10 rounded-xl bg-calabaza/15 border border-calabaza/30 flex items-center justify-center text-calabaza flex-shrink-0">
            {item.icon === 'shield-check' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            )}
            {item.icon === 'truck' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="13" x="1" y="6" rx="2"/>
                <polygon points="17 9 22 9 22 17 17 17 17 9"/>
                <circle cx="5.5" cy="19.5" r="2.5"/>
                <circle cx="18.5" cy="19.5" r="2.5"/>
              </svg>
            )}
            {item.icon === 'refresh-cw' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2v6h-6"/>
                <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
                <path d="M3 22v-6h6"/>
                <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
              </svg>
            )}
            {item.icon === 'flame' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/>
              </svg>
            )}
          </div>
          <div>
            <h4 class="font-heading text-lg sm:text-xl text-hueso tracking-wide m-0 leading-tight">
              {item.title}
            </h4>
            <p class="text-xs text-ceniza mt-1 m-0 leading-snug">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
