---
const items = [
  {
    icon: 'shield-check',
    title: 'Pago Contra Entrega',
    desc: 'Pagas al recibir en tu puerta',
  },
  {
    icon: 'truck',
    title: 'Envío Rápido 1 a 4 Días',
    desc: 'Cobertura en toda Colombia',
  },
  {
    icon: 'refresh-cw',
    title: 'Garantía de Funcionamiento',
    desc: 'Cambio inmediato si presenta fallas',
  },
  {
    icon: 'calendar',
    title: 'Uso Todo el Año',
    desc: 'Halloween, Navidad y fiestas en un solo producto',
  },
];
---

<section class="w-full bg-sombra border-y border-white/10 py-6 sm:py-8" aria-label="Garantías y confianza">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {items.map((item) => (
        <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-3 p-3 rounded-xl bg-noche/40 border border-white/5">
          <div class="w-10 h-10 rounded-xl badge-rgb flex items-center justify-center text-neon-cian flex-shrink-0">
            {item.icon === 'shield-check' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            )}
            {item.icon === 'truck' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="13" x="1" y="6" rx="2"/>
                <polygon points="17 9 22 9 22 17 17 17 17 9"/>
                <circle cx="5.5" cy="19.5" r="2.5"/>
                <circle cx="18.5" cy="19.5" r="2.5"/>
              </svg>
            )}
            {item.icon === 'refresh-cw' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2v6h-6"/>
                <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
                <path d="M3 22v-6h6"/>
                <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
              </svg>
            )}
            {item.icon === 'calendar' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2"/>
                <path d="M16 2v4M8 2v4M3 10h18"/>
                <path d="m9 16 2 2 4-4"/>
              </svg>
            )}
          </div>
          <div>
            <h4 class="font-heading text-lg sm:text-xl text-hueso tracking-wide m-0 leading-tight uppercase">
              {item.title}
            </h4>
            <p class="text-xs text-ceniza mt-1 m-0 leading-snug">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
