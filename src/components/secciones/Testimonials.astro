---
interface Props {
  testimonios: Array<{
    id: string;
    nombre: string;
    ciudad: string;
    foto: string;
    texto: string;
    estrellas: number;
    packComprado: string;
    fecha: string;
  }>;
}

const { testimonios } = Astro.props;

// Distribución de estrellas (basado en 980 reseñas)
const distribution = [
  { stars: 5, percent: 84, count: 823 },
  { stars: 4, percent: 12, count: 118 },
  { stars: 3, percent: 3, count: 29 },
  { stars: 2, percent: 1, count: 7 },
  { stars: 1, percent: 0, count: 3 },
];
---

<section class="py-12 md:py-20 bg-sombra border-y border-white/10 relative">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs uppercase tracking-widest text-calabaza font-bold px-3 py-1 rounded-full bg-calabaza/10 border border-calabaza/20 inline-block mb-3">
        Opiniones Comprobadas
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-hueso tracking-wide m-0">
        LO QUE DICEN QUIENES YA LA TIENEN
      </h2>
      <p class="text-ceniza text-sm sm:text-base mt-3 m-0">
        Más de 980 clientes en Colombia ya recibieron su máscara antes de Halloween.
      </p>
    </div>

    {/* Resumen 4,7 de 5 con desglose de barras */}
    <div class="bg-noche/80 border border-white/10 rounded-[14px] p-6 sm:p-8 max-w-3xl mx-auto mb-12 shadow-xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        
        {/* Puntuación media */}
        <div class="text-center md:border-r border-white/10 md:pr-6">
          <div class="font-heading text-6xl sm:text-7xl text-hueso font-bold leading-none tabular-nums">
            4.7
          </div>
          <div class="flex justify-center text-calabaza text-lg my-1.5" aria-hidden="true">
            ★★★★★
          </div>
          <span class="text-xs text-ceniza block">
            Basado en 980 calificaciones verificadas
          </span>
          <span class="inline-block mt-2 text-[11px] font-bold text-emerald-400 bg-emerald-950/60 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
            ✓ 96% Recomendación positiva
          </span>
        </div>

        {/* Barras de distribución */}
        <div class="md:col-span-2 space-y-1.5">
          {distribution.map((d) => (
            <div class="flex items-center gap-3 text-xs">
              <span class="w-12 text-ceniza font-medium flex items-center gap-1 flex-shrink-0">
                <span>{d.stars}</span>
                <span class="text-calabaza">★</span>
              </span>
              <div class="flex-1 h-2.5 bg-white/10 rounded-full overflow-hidden">
                <div
                  class="h-full bg-calabaza rounded-full"
                  style={`width: ${d.percent}%`}
                ></div>
              </div>
              <span class="w-10 text-right text-ceniza tabular-nums font-semibold flex-shrink-0">
                {d.percent}%
              </span>
            </div>
          ))}
        </div>

      </div>
    </div>

    {/* Grid de 6 Reseñas detalladas */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {testimonios.map((t) => (
        <div class="bg-noche/60 border border-white/10 rounded-[14px] p-5 flex flex-col justify-between hover:border-calabaza/30 transition-colors shadow-lg">
          <div>
            {/* Cabecera del usuario */}
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-2.5">
                <img
                  src={t.foto}
                  alt={t.nombre}
                  width="40"
                  height="40"
                  loading="lazy"
                  class="w-10 h-10 rounded-full object-cover border border-calabaza/40 flex-shrink-0"
                />
                <div>
                  <h4 class="text-sm font-bold text-hueso leading-tight m-0">
                    {t.nombre}
                  </h4>
                  <span class="text-xs text-ceniza flex items-center gap-1">
                    <span>📍</span> {t.ciudad}
                  </span>
                </div>
              </div>
              <span class="text-[11px] text-ceniza">
                {t.fecha}
              </span>
            </div>

            {/* Estrellas */}
            <div class="flex items-center gap-1.5 text-calabaza text-sm mb-2" aria-hidden="true">
              {'★'.repeat(t.estrellas)}
              <span class="text-[11px] text-emerald-400 font-semibold ml-1">
                ✓ Compra verificada
              </span>
            </div>

            {/* Texto de la reseña */}
            <p class="text-sm text-hueso/90 leading-relaxed italic m-0">
              "{t.texto}"
            </p>
          </div>

          {/* Badge del pack comprado */}
          <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-xs text-ceniza">
            <span>Compró:</span>
            <span class="font-semibold text-calabaza bg-calabaza/10 px-2 py-0.5 rounded border border-calabaza/20">
              {t.packComprado}
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
