---
interface Props {
  testimonios: Array<{
    nombre: string;
    ciudad: string;
    foto: string;
    texto: string;
  }>;
}

const { testimonios } = Astro.props;
---

<section class="py-12 md:py-20 bg-noche relative">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs uppercase tracking-widest text-calabaza font-bold px-3 py-1 rounded-full bg-calabaza/10 border border-calabaza/20 inline-block mb-3">
        Clientes Reales
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-hueso tracking-wide m-0">
        CÓMO SE VE PUESTA
      </h2>
      <p class="text-ceniza text-sm sm:text-base mt-3 m-0">
        Fotos enviadas directamente por clientes en fiestas, discotecas y conjuntos residenciales en toda Colombia.
      </p>
    </div>

    {/* Galería de 6 fotos UGC */}
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3.5 sm:gap-6">
      {testimonios.map((t, idx) => (
        <div class="group relative rounded-[14px] overflow-hidden bg-sombra border border-white/10 shadow-lg aspect-[4/5] sm:aspect-square">
          <img
            src={t.foto}
            alt={`Cliente con máscara en ${t.ciudad}`}
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />

          {/* Gradiente inferior */}
          <div class="absolute inset-0 bg-gradient-to-t from-noche via-noche/30 to-transparent opacity-85 group-hover:opacity-90 transition-opacity"></div>

          {/* Información de la foto */}
          <div class="absolute bottom-0 inset-x-0 p-3 sm:p-4 text-left">
            <div class="flex items-center gap-1.5 mb-1">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-xs font-bold text-hueso leading-none truncate">
                {t.nombre}
              </span>
            </div>
            <div class="text-[11px] text-calabaza font-semibold flex items-center gap-1">
              <span>📍</span>
              <span>{t.ciudad}</span>
            </div>
            <p class="text-[11px] text-ceniza/90 line-clamp-2 mt-1 leading-snug hidden sm:block m-0">
              "{t.texto}"
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
