---
import { Picture } from 'astro:assets';
import imgFicha from '../../assets/images/bloques/ficha-tecnica-contenido.png';

interface Props {
  producto: {
    especificaciones: {
      diametro: string;
      leds: number;
      alimentacion: string;
      control: string[];
    };
    incluye: string[];
  };
}

const { producto } = Astro.props;
const { especificaciones: esp } = producto;

const fichas = [
  {
    icon: '📐',
    titulo: 'Dimensiones y Cobertura',
    texto: `Diámetro total de ${esp.diametro} con ${esp.leds} nodos LED RGB de alto brillo.`,
  },
  {
    icon: '📡',
    titulo: 'Control Inteligente Dual',
    texto: 'Bluetooth vía App (iOS / Android) + Control remoto infrarrojo de 20 botones.',
  },
  {
    icon: '🔋',
    titulo: 'Alimentación y Material',
    texto: `Puerto ${esp.alimentacion}; cableado flexible de alta resistencia con protección impermeable en los LEDs.`,
  },
];
---

<section class="py-14 md:py-24 bg-noche relative">
  <div class="max-w-6xl mx-auto px-4">

    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="badge-rgb text-xs uppercase tracking-widest text-hueso font-bold px-3 py-1 rounded-full inline-block mb-3">
        Ficha Técnica
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-hueso tracking-wide m-0">
        ESPECIFICACIONES Y CONTENIDO DE LA CAJA
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      {/* Imagen técnica 1:1 */}
      <div class="aspect-square rounded-2xl overflow-hidden borde-rgb shadow-2xl">
        <Picture
          pictureAttributes={{ class: 'block w-full h-full' }}
          src={imgFicha}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 560px, 92vw"
          alt="Malla LED RGB de 135 cm encendida junto al control remoto de 20 botones y el cable USB"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover rounded-2xl"
        />
      </div>

      {/* 4 contenedores de especificaciones */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {fichas.map((f) => (
          <div class="rounded-2xl p-5 bg-sombra border border-white/10">
            <div class="text-2xl mb-2" aria-hidden="true">{f.icon}</div>
            <h3 class="font-heading text-xl sm:text-2xl text-hueso tracking-wide m-0 leading-tight">
              {f.titulo}
            </h3>
            <p class="text-sm text-ceniza leading-relaxed m-0 mt-1.5">
              {f.texto}
            </p>
          </div>
        ))}

        <div class="rounded-2xl p-5 borde-rgb">
          <div class="text-2xl mb-2" aria-hidden="true">📦</div>
          <h3 class="font-heading text-xl sm:text-2xl text-hueso tracking-wide m-0 leading-tight">
            ¿Qué incluye tu paquete?
          </h3>
          <ul class="list-none p-0 m-0 mt-2 space-y-1 text-sm text-hueso/90">
            {producto.incluye.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-neon-cian" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

  </div>
</section>
