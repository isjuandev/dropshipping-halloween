---
interface Props {
  ideas: Array<{
    id: string;
    titulo: string;
    descripcion: string;
    foto: string;
    packId: string;
    etiqueta: string;
  }>;
}

const { ideas } = Astro.props;
---

<section class="py-12 md:py-20 bg-noche relative">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs uppercase tracking-widest text-calabaza font-bold px-3 py-1 rounded-full bg-calabaza/10 border border-calabaza/20 inline-block mb-3">
        Inspiración Rápida
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-hueso tracking-wide m-0">
        IDEAS DE DISFRAZ EN 10 SEGUNDOS
      </h2>
      <p class="text-ceniza text-sm sm:text-base mt-3 m-0">
        Mira cómo puedes combinar tu máscara para ser el centro de atención en cualquier evento.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {ideas.map((idea) => (
        <div class="bg-sombra border border-white/10 rounded-[14px] overflow-hidden flex flex-col justify-between group hover:border-calabaza/40 transition-all shadow-xl">
          
          <div class="aspect-[4/3] w-full overflow-hidden bg-noche relative">
            <img
              src={idea.foto}
              alt={idea.titulo}
              width="400"
              height="300"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-3 right-3 px-2.5 py-1 rounded-lg bg-sangre text-hueso text-xs font-bold uppercase tracking-wider shadow">
              {idea.etiqueta}
            </div>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-heading text-2xl text-hueso tracking-wide mb-2 m-0">
                {idea.titulo}
              </h3>
              <p class="text-ceniza text-sm leading-relaxed m-0">
                {idea.descripcion}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/5">
              <a
                href="#seccion-packs"
                class="inline-flex items-center gap-2 text-calabaza hover:text-calabaza-hover text-sm font-bold tracking-wide group-hover:translate-x-1 transition-transform"
              >
                <span>Ver este pack recomendado</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
