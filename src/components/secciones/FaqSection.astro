---
interface Props {
  faqs: Array<{
    id: string;
    pregunta: string;
    respuesta: string;
    orden: number;
  }>;
}

const { faqs } = Astro.props;
const faqsOrdenadas = [...faqs].sort((a, b) => a.orden - b.orden);
---

<section class="py-12 md:py-20 bg-noche relative border-y border-white/10">
  <div class="max-w-4xl mx-auto px-4">
    
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs uppercase tracking-widest text-calabaza font-bold px-3 py-1 rounded-full bg-calabaza/10 border border-calabaza/20 inline-block mb-3">
        Resolvemos Tus Dudas
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-hueso tracking-wide m-0">
        PREGUNTAS FRECUENTES
      </h2>
      <p class="text-ceniza text-sm sm:text-base mt-3 m-0">
        Todo lo que necesitas saber antes de pedir tu Malla LED RGB.
      </p>
    </div>

    {/* Acordeón accesible usando <details> puro sin JS */}
    <div class="space-y-3.5">
      {faqsOrdenadas.map((faq, idx) => (
        <details
          class="group bg-sombra border border-white/10 rounded-[14px] overflow-hidden transition-all duration-200 open:border-calabaza/40 open:bg-sombra/90 shadow-md"
          open={idx === 0}
        >
          <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer list-none select-none text-left font-heading text-xl sm:text-2xl text-hueso tracking-wide hover:text-calabaza transition-colors">
            <span class="pr-4">{faq.pregunta}</span>
            <span class="w-8 h-8 rounded-full bg-noche border border-white/10 flex items-center justify-center text-ceniza text-sm flex-shrink-0 group-open:rotate-180 group-open:text-calabaza transition-transform duration-200">
              ▼
            </span>
          </summary>
          <div class="px-5 pb-5 sm:px-6 sm:pb-6 text-sm sm:text-base text-ceniza leading-relaxed border-t border-white/5 pt-3">
            {faq.respuesta}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
