---
import VariantSelector from '../islas/VariantSelector';
import { formatCOP } from '../../lib/pedido-schema';

interface Props {
  producto: {
    nombre: string;
    precio: number;
    precioAnterior: number;
    imagenes: string[];
    rating: number;
    numResenas: number;
  };
}

const { producto } = Astro.props;
const ahorro = producto.precioAnterior - producto.precio;
---

<section id="hero-section" class="relative overflow-hidden bg-noche py-8 md:py-16 border-b border-white/10">
  {/* Haz de linterna interactivo y gradiente de fondo */}
  <div id="hero-flashlight" class="absolute inset-0 pointer-events-none z-10 transition-all duration-300"></div>

  {/* Niebla atmosférica animada SVG lenta (40s) */}
  <div class="absolute inset-0 pointer-events-none opacity-25 z-0 animate-fog overflow-hidden" aria-hidden="true">
    <svg class="w-[200%] h-full min-h-[600px]" viewBox="0 0 1200 600" preserveAspectRatio="none" fill="none">
      <path d="M0 300 C 300 200, 600 400, 1200 300 L 1200 600 L 0 600 Z" fill="url(#fogGradient)"></path>
      <defs>
        <radialGradient id="fogGradient" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#2A1B3D" stop-opacity="0.8"></stop>
          <stop offset="60%" stop-color="#16141A" stop-opacity="0.4"></stop>
          <stop offset="100%" stop-color="#0A0A0B" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
    </svg>
  </div>

  <div class="max-w-6xl mx-auto px-4 relative z-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      
      {/* Columna Izquierda: Video + Galería scroll-snap con miniaturas */}
      <div class="space-y-4">
        {/* Contenedor Principal (Foto destacada / Video) */}
        <div class="relative rounded-[14px] overflow-hidden border border-white/15 bg-sombra shadow-2xl group">
          {/* Badge -40% */}
          <div class="absolute top-3 left-3 z-30 px-3 py-1 bg-sangre text-hueso text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-lg">
            -40% DESCUENTO
          </div>

          <div class="absolute top-3 right-3 z-30 px-2.5 py-1 bg-noche/80 backdrop-blur border border-white/10 text-calabaza text-[11px] font-semibold rounded-lg flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-calabaza animate-ping"></span>
            <span>Alta Demanda</span>
          </div>

          {/* Imagen principal interactiva con microinteracción de parpadeo */}
          <div class="aspect-[4/5] sm:aspect-square w-full overflow-hidden bg-noche relative cursor-pointer" id="hero-main-photo">
            <img
              id="hero-active-image"
              src={producto.imagenes[0]}
              alt="Máscara fantasma de terror blanca con capucha negra puesta"
              width="600"
              height="600"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            />
            {/* Efecto de borde iluminado sobre la máscara blanca */}
            <div class="absolute inset-0 bg-gradient-to-t from-noche via-transparent to-transparent opacity-60 pointer-events-none"></div>
          </div>
        </div>

        {/* Galería scroll-snap con 5 fotos + Video */}
        <div>
          <div class="text-xs text-ceniza font-semibold mb-2 flex items-center justify-between">
            <span>Toca para ver detalles:</span>
            <span class="text-[11px]">5 fotos + vista real</span>
          </div>
          <div class="flex gap-2.5 overflow-x-auto pb-2 no-scrollbar snap-x snap-mandatory">
            {producto.imagenes.map((img, idx) => {
              const labels = ['Frente', 'Perfil', 'Puesta', 'En grupo', 'Capucha'];
              return (
                <button
                  type="button"
                  class="relative flex-shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border-2 border-white/10 hover:border-calabaza focus:border-calabaza transition-all snap-start cursor-pointer bg-sombra"
                  onclick={`document.getElementById('hero-active-image').src = '${img}';`}
                  aria-label={`Ver vista ${labels[idx] || idx + 1}`}
                >
                  <img
                    src={img}
                    alt={`Vista ${labels[idx] || idx + 1}`}
                    width="80"
                    height="80"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                  <span class="absolute bottom-0 inset-x-0 bg-noche/80 text-[9px] text-center font-bold text-hueso py-0.5 truncate">
                    {labels[idx]}
                  </span>
                </button>
              );
            })}
          </div>
        </div>
      </div>

      {/* Columna Derecha: Oferta, H1, Bullets, Variantes y CTA */}
      <div class="space-y-4 sm:space-y-5">
        
        {/* Rating y Reseñas */}
        <div class="flex items-center gap-2">
          <div class="flex text-calabaza text-base" aria-hidden="true">
            ★★★★★
          </div>
          <span class="text-sm font-bold text-hueso tabular-nums">
            {producto.rating}
          </span>
          <span class="text-xs text-ceniza">
            ({producto.numResenas.toLocaleString('es-CO')} reseñas verificadas)
          </span>
        </div>

        {/* H1 Principal con Creepster en "GRITEN" */}
        <div>
          <h1 class="font-heading text-[48px] sm:text-[56px] lg:text-[76px] leading-[0.95] text-hueso uppercase tracking-tight m-0">
            QUE <span class="font-display text-calabaza tracking-normal drop-shadow-[0_0_15px_rgba(255,106,0,0.5)]">GRITEN</span> AL VERTE
          </h1>
          <p class="text-base sm:text-lg text-ceniza mt-2 leading-relaxed">
            Máscara + capucha integrada. <strong class="text-hueso">El disfraz más fácil de Halloween.</strong>
          </p>
        </div>

        {/* Precios y Ahorro */}
        <div class="bg-sombra/90 border border-white/10 rounded-2xl p-4 flex flex-wrap items-baseline gap-3 shadow-inner">
          <div class="font-heading text-4xl sm:text-5xl text-hueso tabular-nums font-bold">
            {formatCOP(producto.precio)}
          </div>
          <div class="text-base sm:text-lg text-ceniza line-through tabular-nums">
            {formatCOP(producto.precioAnterior)}
          </div>
          <div class="px-2.5 py-1 rounded-md bg-calabaza/20 border border-calabaza/40 text-calabaza text-xs sm:text-sm font-bold uppercase tracking-wide">
            Ahorras {formatCOP(ahorro)}
          </div>
        </div>

        {/* 3 Bullets de alta conversión */}
        <ul class="space-y-2 text-sm sm:text-base text-hueso/90 list-none p-0 m-0">
          <li class="flex items-center gap-2.5">
            <span class="w-5 h-5 rounded-full bg-calabaza/20 text-calabaza flex items-center justify-center text-xs font-bold flex-shrink-0">✓</span>
            <span><strong>Lista para usar en 10 segundos:</strong> póntela y listo.</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="w-5 h-5 rounded-full bg-calabaza/20 text-calabaza flex items-center justify-center text-xs font-bold flex-shrink-0">✓</span>
            <span><strong>Ves y respiras cómodo:</strong> malla ocular y aperturas ocultas.</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="w-5 h-5 rounded-full bg-calabaza/20 text-calabaza flex items-center justify-center text-xs font-bold flex-shrink-0">✓</span>
            <span><strong>Talla adulto y niño:</strong> ajuste elástico que no se cae.</span>
          </li>
        </ul>

        {/* Isla Selector de Modelo, Talla, Stock y Botón CTA */}
        <VariantSelector client:visible />

      </div>

    </div>
  </div>
</section>
