---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Resena {
  nombre: string;
  ciudad: string;
  foto?: ImageMetadata;
  video?: { src: string; poster: string };
  texto: string;
  estrellas: number;
  packComprado: string;
  fecha: string;
}

interface Props {
  resena: Resena;
}

const { resena: t } = Astro.props;
---

<article class="break-inside-avoid bg-noche/70 border border-white/10 rounded-2xl overflow-hidden hover:border-neon-morado/40 transition-colors shadow-lg">
  {t.video && (
    <div class="aspect-[4/5] overflow-hidden bg-noche">
      {/* Video UGC sin sonido: muted + sin controles, en bucle y en línea (iOS) */}
      <video
        src={t.video.src}
        poster={t.video.poster}
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        disableremoteplayback
        preload="metadata"
        aria-label={`Video de la malla LED instalada por ${t.nombre} en ${t.ciudad}`}
        class="w-full h-full object-cover rounded-2xl pointer-events-none"
      ></video>
    </div>
  )}

  {!t.video && t.foto && (
    <div class="aspect-[4/5] overflow-hidden">
      <Picture
        pictureAttributes={{ class: 'block w-full h-full' }}
        src={t.foto}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 360px, (min-width: 768px) 45vw, 92vw"
        alt={`Malla LED instalada por ${t.nombre} en ${t.ciudad}`}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover rounded-2xl"
      />
    </div>
  )}

  <div class="p-5">
    <div class="flex items-center justify-between gap-3 mb-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="w-10 h-10 rounded-full bg-gradient-to-br from-neon-morado to-neon-cian flex items-center justify-center font-heading text-xl text-white flex-shrink-0" aria-hidden="true">
          {t.nombre.charAt(0)}
        </span>
        <div class="min-w-0">
          <h3 class="text-sm font-bold text-hueso leading-tight m-0">{t.nombre}</h3>
          <span class="text-xs text-ceniza flex items-center gap-1">
            <span aria-hidden="true">📍</span> {t.ciudad}
          </span>
        </div>
      </div>
      <span class="text-[11px] text-ceniza whitespace-nowrap">{t.fecha}</span>
    </div>

    <div class="flex items-center gap-1.5 text-sm mb-2">
      <span aria-label={`${t.estrellas} de 5 estrellas`}>
        <span class="text-calabaza">{'★'.repeat(t.estrellas)}</span><span class="text-white/20">{'★'.repeat(5 - t.estrellas)}</span>
      </span>
      <span class="text-[11px] text-emerald-400 font-semibold ml-1">✓ Compra verificada</span>
    </div>

    <p class="text-sm text-hueso/90 leading-relaxed italic m-0">"{t.texto}"</p>

    <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-xs text-ceniza">
      <span>Compró:</span>
      <span class="font-semibold text-neon-cian bg-neon-cian/10 px-2 py-0.5 rounded border border-neon-cian/25">
        {t.packComprado}
      </span>
    </div>
  </div>
</article>
