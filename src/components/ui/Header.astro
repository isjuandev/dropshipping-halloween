---
import { tiendaConfig } from '../../config/tienda';
---

<header class="w-full bg-noche/90 border-b border-white/10 relative z-40 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo sin menú para evitar fugas de conversión -->
    <a href="/malla-led-rgb-135cm" class="flex items-center gap-2.5 text-hueso no-underline group focus-visible:outline-calabaza" aria-label={`Inicio - ${tiendaConfig.nombreTienda}`}>
      <img
        src="/favicon.svg"
        alt={`Logo ${tiendaConfig.nombreTienda}`}
        width="38"
        height="38"
        class="w-9.5 h-9.5 rounded-xl shadow-md shadow-calabaza/25 group-hover:scale-105 transition-transform object-cover"
      />
      <div class="flex flex-col">
        <span class="font-heading tracking-wider text-xl sm:text-2xl leading-none text-hueso font-bold">
          {tiendaConfig.nombreTienda}
        </span>
        <span class="text-[10px] uppercase tracking-widest text-neon-cian font-semibold leading-none mt-0.5">
          Decoración LED Inteligente
        </span>
      </div>
    </a>

    <!-- Botón directo hacia el selector de packs + checkout (lleva a la landing si estamos en otra página) -->
    <a
      href="/malla-led-rgb-135cm#seccion-packs"
      data-cta
      class="flex items-center gap-2 px-4 py-2 rounded-xl bg-calabaza hover:bg-calabaza-hover text-noche transition-all text-xs sm:text-sm font-bold uppercase tracking-wider focus-visible:outline-calabaza min-h-[44px] shadow-md shadow-calabaza/10"
    >
      <span>PEDIR AHORA</span>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </a>
  </div>
</header>
