---
import { tiendaConfig } from '../../config/tienda';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

const whatsappUrl = buildWhatsAppUrl({ origen: 'header_icon' });
---

<header class="w-full bg-noche/90 border-b border-white/10 sticky top-0 z-40 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo sin menú para evitar fugas de conversión -->
    <a href="/" class="flex items-center gap-2.5 text-hueso no-underline group focus-visible:outline-calabaza" aria-label={`Inicio - ${tiendaConfig.nombreTienda}`}>
      <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-calabaza to-sangre flex items-center justify-center text-noche font-heading text-2xl font-bold shadow-md shadow-calabaza/20 group-hover:scale-105 transition-transform">
        G
      </span>
      <div class="flex flex-col">
        <span class="font-heading tracking-wider text-xl sm:text-2xl leading-none text-hueso font-bold">
          {tiendaConfig.nombreTienda}
        </span>
        <span class="text-[10px] uppercase tracking-widest text-calabaza font-semibold leading-none mt-0.5">
          Halloween 2026
        </span>
      </div>
    </a>

    <!-- Ícono directo de WhatsApp -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener"
      class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-whatsapp/15 border border-whatsapp/30 text-whatsapp hover:bg-whatsapp hover:text-white transition-all text-xs font-semibold focus-visible:outline-calabaza min-h-[44px]"
      aria-label="Atención al cliente por WhatsApp"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.06c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.03 8.03 0 01-1.23-4.29c0-4.47 3.64-8.11 8.12-8.11 2.17 0 4.21.85 5.74 2.38a8.07 8.07 0 012.38 5.73c-.01 4.47-3.65 8.11-8.12 8.11zm4.45-6.08c-.24-.12-1.45-.72-1.68-.8-.23-.08-.39-.12-.56.12-.17.24-.64.8-.78.96-.15.16-.29.18-.54.06-.24-.12-1.03-.38-1.96-1.21-.73-.65-1.22-1.45-1.36-1.7-.14-.24-.02-.37.1-.49.11-.11.24-.29.37-.43.12-.15.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.24-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.76 2.68 4.26 3.76.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.45-.59 1.66-1.16.2-.58.2-1.07.14-1.16-.06-.1-.23-.16-.47-.28z"/>
      </svg>
      <span class="hidden sm:inline">WhatsApp directo</span>
    </a>
  </div>
</header>
