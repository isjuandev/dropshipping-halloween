---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import imgHero from '../assets/images/hero/telarana-ventana.png';
import { tiendaConfig } from '../config/tienda';
import HalloweenCountdown from '../components/islas/HalloweenCountdown';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import StickyBar from '../components/islas/StickyBar';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  jsonLd?: Record<string, any>[];
}

const {
  title = `Malla LED RGB Inteligente 135 cm para Halloween y Navidad | ${tiendaConfig.nombreTienda}`,
  description = 'Malla LED RGB de 135 cm con 120 luces, App Bluetooth + Control Remoto y ritmo musical. Telaraña neón en Halloween y estrella en Navidad. Pago contra entrega en toda Colombia.',
  image,
  robots = 'index, follow',
  jsonLd = [],
} = Astro.props;

// Imagen OG y miniatura de la barra fija optimizadas en build
const ogImage = await getImage({ src: imgHero, width: 1024, format: 'jpg' });
const miniatura = await getImage({ src: imgHero, width: 96, height: 96, format: 'webp' });

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://mascaradelgrito.co').toString();
const ogImageUrl = new URL(image ?? ogImage.src, Astro.site || 'https://mascaradelgrito.co').toString();

// Schema.org Organización por defecto
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tiendaConfig.nombreTienda,
  legalName: tiendaConfig.razonSocial,
  taxID: tiendaConfig.nit,
  url: Astro.site ? Astro.site.toString() : 'https://mascaradelgrito.co',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    areaServed: 'CO',
    availableLanguage: 'Spanish',
  },
};

const allSchemas = [orgSchema, ...jsonLd];
---

<!doctype html>
<html lang="es-CO" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#09090b" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="product" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={tiendaConfig.nombreTienda} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🕸️%3C/text%3E%3C/svg%3E" />

    <!-- Preload Fonts -->
    <link
      rel="preload"
      href="/fonts/bebas-neue.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Schema.org JSON-LD -->
    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <!-- GTM & Meta Pixel Analytics (solo si hay IDs configurados) -->
    {
      tiendaConfig.gtmId && (
        <script is:inline define:vars={{ gtmId: tiendaConfig.gtmId }}>
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer',gtmId);
        </script>
      )
    }

    {
      tiendaConfig.pixelId && (
        <script is:inline define:vars={{ pixelId: tiendaConfig.pixelId }}>
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', pixelId);
          fbq('track', 'PageView');
        </script>
      )
    }
  </head>
  <body class="bg-noche text-hueso antialiased selection:bg-calabaza selection:text-noche relative">
    <!-- Capa de grano sutil (4%) -->
    <div class="fixed inset-0 bg-grain pointer-events-none z-30" aria-hidden="true"></div>

    <!-- Viñeta oscura periférica -->
    <div class="fixed inset-0 pointer-events-none z-20 shadow-[inset_0_0_120px_rgba(0,0,0,0.85)]" aria-hidden="true"></div>

    <!-- 1. Barra de anuncio superior (Isla HalloweenCountdown) -->
    <HalloweenCountdown client:visible />

    <!-- 2. Header mínimo -->
    <Header />

    <!-- Contenido principal -->
    <main id="main-content" class="relative z-10">
      <slot />
    </main>

    <!-- 16. Footer -->
    <Footer />

    <!-- Barra fija inferior móvil hacia el formulario (Isla Preact client:idle) -->
    <StickyBar client:idle miniatura={miniatura.src} />

    <!-- Captura de UTMs en sessionStorage y Microinteracciones -->
    <script is:inline>
      (function() {
        // Captura de UTMs al entrar a la landing
        try {
          const urlParams = new URLSearchParams(window.location.search);
          const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid'];
          const collected = {};
          let hasUtm = false;

          utmKeys.forEach(function(key) {
            const val = urlParams.get(key);
            if (val) {
              collected[key] = val;
              hasUtm = true;
            }
          });

          if (hasUtm) {
            sessionStorage.setItem('tienda_utm_data', JSON.stringify(collected));
          }
        } catch (e) {}

        // Respetar preferencias de reducción de movimiento
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        // Resplandor neón interactivo sobre el hero
        const heroSection = document.getElementById('hero-section');
        const flashlight = document.getElementById('hero-flashlight');
        if (heroSection && flashlight) {
          heroSection.addEventListener('pointermove', function(e) {
            const rect = heroSection.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            flashlight.style.background = `radial-gradient(circle 320px at ${x}px ${y}px, rgba(168, 85, 247, 0.16), rgba(6, 182, 212, 0.06) 50%, transparent 80%)`;
          });
        }
      })();
    </script>
  </body>
</html>
